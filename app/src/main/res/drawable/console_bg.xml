<?xml version="1.0" encoding="utf-8"?>
<!-- Console strip surface: same field black as the patch canvas plus a
     hairline bottom edge so the console and the patch area read as two
     regions (PC-98 pd98_line). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pd98_field" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/pd98_line" />
        </shape>
    </item>
</layer-list>
