<?xml version="1.0" encoding="utf-8"?>
<!-- PC-98 popup window (design 02 long-press menu): body panel with edge
     stroke, hard shadow offset +6dp @55% black. Square, of course. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#8C000000" />
        </shape>
    </item>
    <item android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pd98_body" />
            <stroke
                android:width="1dp"
                android:color="@color/pd98_edge" />
        </shape>
    </item>
</layer-list>
