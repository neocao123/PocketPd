<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar keycap (design 01–03): field fill + edge stroke, sits on the
     chrome-blue title bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pd98_field" />
    <stroke
        android:width="1dp"
        android:color="@color/pd98_edge" />
</shape>
