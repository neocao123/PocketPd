#N canvas 0 0 720 520 10;
#X text 40 30 MIDI keyboard demo. Pick a MIDI device in Settings\, turn DSP on\, play notes.;
#X text 40 60 notein -> pitch/velocity -> sine voice -> output.;
#X obj 60 130 notein;
#X obj 60 190 stripnote;
#X obj 60 250 mtof;
#X obj 60 310 osc~;
#X obj 220 190 / 127;
#X obj 220 250 sig~;
#X obj 60 380 *~;
#X obj 60 440 dac~;
#X connect 2 0 3 0;
#X connect 2 1 6 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 8 0;
#X connect 6 0 7 0;
#X connect 7 0 8 1;
#X connect 8 0 9 0;
#X connect 8 0 9 1;
