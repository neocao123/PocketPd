#N canvas 0 0 720 640 10;
#X text 40 30 OSC demo. Enable OSC in Settings (listen port 8000).;
#X text 40 60 Send /synth/freq 440 and /synth/gain 0.2 via UDP to control the voice.;
#X text 40 90 The slider sends /synth/vol to the OSC target (10.0.2.2:9000).;
#X obj 60 180 r synth/freq;
#X obj 60 240 osc~;
#X obj 250 180 r synth/gain;
#X obj 250 240 sig~;
#X obj 60 310 *~;
#X obj 60 370 dac~;
#X obj 60 460 hsl 128 25 0 1 0 empty synth/vol empty -2 -8 0 12 -262144 -1 -1 0 1;
#X obj 60 520 r synth/vol;
#X obj 60 570 list prepend /synth/vol;
#X obj 60 620 s OSC;
#X connect 3 0 4 0;
#X connect 4 0 7 0;
#X connect 5 0 6 0;
#X connect 6 0 7 1;
#X connect 7 0 8 0;
#X connect 7 0 8 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
