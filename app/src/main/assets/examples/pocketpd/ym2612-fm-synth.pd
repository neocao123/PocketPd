#N canvas 0 0 460 440 10;
#X text 30 20 ym2612~ FM synth - play it with a MIDI keyboard.;
#X text 30 36 The slider picks the GM instrument (1-128) with int steps.;
#X obj 30 90 notein;
#X obj 30 150 pack f f;
#X obj 30 190 list prepend note;
#X obj 30 220 list trim;
#X obj 30 280 ym2612~;
#X obj 30 320 *~ 0.2;
#X obj 30 370 dac~ 1 2;
#X obj 330 90 hsl 160 18 1 128 0 1 empty empty instrument -10 -8 0 12 #dfdfdf #000000 #000000 0 1 #int;
#X msg 330 160 gm \$1;
#X obj 330 220 loadbang;
#X msg 330 260 gm 1;
#X text 30 410 notein sends velocity before pitch - the velocity stores in pack's right inlet and the pitch fires note <pitch> <vel>. A note-off arrives as velocity 0 and mutes the voice.;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 0 8 1;
#X connect 9 0 10 0;
#X connect 10 0 6 0;
#X connect 11 0 12 0;
#X connect 12 0 6 0;
