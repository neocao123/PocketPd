#X text 12 398 alg 0-7;
#X text 150 398 routing - see carrier table below;
#X text 12 415 fb 0-7;
#X text 150 415 op 1 self-feedback (growl / edge);
#X text 12 432 mul 0-15;
#X text 150 432 pitch ratio (0 = x0.5 - 1-15 = x1-x15);
#X text 12 449 det 0-7;
#X text 150 449 fine detune;
#X text 12 466 tl 0-127;
#X text 150 466 output ATTENUATION: 0 loudest - 127 silent;
#X text 12 483 ar 0-31;
#X text 150 483 attack speed (31 = instant);
#X text 12 500 dr 0-31;
#X text 150 500 decay speed (into the sustain segment);
#X text 12 517 sl 0-15;
#X text 150 517 sustain ATTENUATION: 0 = full - 15 = silence;
#X text 12 534 sr 0-31;
#X text 150 534 sustain fall speed (0 = hold while gated);
#X text 12 551 rr 0-31;
#X text 150 551 release speed after gate off;
#X text 12 568 dac 0-100;
#X text 150 568 output grit (9-bit DAC curve);
#X text 12 592 gm 1-128;
#X text 150 592 General MIDI Level 1 preset (sets alg fb + all op params - leaves dac);
#X text 12 615 bank <file.wopn> - swap the whole 128-preset GM table at runtime (WOPN v2 or v1 \, melodic bank 0). bank default = back to the compiled table;
#X obj 12 644 cnv 3 696 3 empty empty banks - shipped .wopn files 8 12 0 13 -228856 -1 0;
#X msg 12 664 bank default;
#X msg 12 692 bank fmtowns.wopn;
