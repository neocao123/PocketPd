#X obj 100 224 tgl 24 0 empty empty empty 17 7 0 10 -262144 -1 -1 1;
#X text 140 254 gate: 1 key on - 0 release;
#X obj 20 290 *~ 0.2;
#X obj 20 340 dac~;
