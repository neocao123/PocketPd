#X msg 250 88 fb 4;
#X msg 250 112 op 4 ar 31;
#X msg 250 136 op 4 dr 18;
#X msg 250 160 op 4 sl 15;
#X msg 250 184 op 4 rr 15;
#X text 350 112 pluck envelope on op 4 (see ADSR);
#X msg 470 64 op 1 mul 2;
#X msg 470 88 op 3 tl 40;
#X msg 470 112 dac 30;
#X text 560 64 timbre / grit;
