#X msg 20 64 note 60 100;
#X msg 20 88 note 64 90;
#X msg 20 112 gm 5;
#X msg 20 136 gm 33;
#X text 100 112 GM 5 Electric Piano 1;
#X text 100 136 GM 33 Acoustic Bass;
